@charset "UTF-8";
/* site global styling */
html,
body {
  height: 100%; }

/* Restore Bootstrap 3 body font; BS5 uses system font stack */
body {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 14px;
  color: #555; }

/* Site-wide link hover: darker blue, no underline */
a:hover,
a:focus {
  color: #003d82;
  text-decoration: none; }

#wrap {
  min-height: 100%;
  height: auto !important;
  height: 100%;
  margin: 0 auto -60px; }

/* Match Bootstrap 3 container width; BS5 grows to 1320px on xxl */
.container {
  max-width: 1024px; }

#wrap > .container {
  padding-top: 50px; }

#push {
  height: 60px; }

hr.fancy-rule {
  border: none;
  width: 75%;
  height: 5px;
  background-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0.05), rgba(136, 177, 22, 0.35), rgba(0, 0, 0, 0.05));
  background-image: -moz-linear-gradient(left, rgba(0, 0, 0, 0), rgba(121, 153, 34, 0.15), rgba(0, 0, 0, 0));
  background-image: -ms-linear-gradient(left, rgba(0, 0, 0, 0), rgba(121, 153, 34, 0.15), rgba(0, 0, 0, 0));
  background-image: -o-linear-gradient(left, rgba(0, 0, 0, 0), rgba(121, 153, 34, 0.15), rgba(0, 0, 0, 0));
  margin: 25px; }

footer {
  height: 60px;
  background-color: #ccc; }

.sidebar {
  background-color: #eee; }

table.center {
  margin-left: auto;
  margin-right: auto;
  margin-top: 15px;
  margin-bottom: 15px; }

table.fire-record {
  border-bottom-style: solid;
  border-bottom-width: 2px;
  margin-bottom: 1.5em; }
  table.fire-record td,
  table.fire-record th {
    padding: 2px 5px 2px 5px; }
  table.fire-record th {
    border-bottom-style: solid;
    border-bottom-width: 2px; }

.center {
  text-align: center; }
  .center img {
    width: 580px; }
  .center table {
    margin-top: 15px;
    margin-bottom: 15px; }

.scenario-table {
  text-align: center;
  border-spacing: 0.5rem;
  border: 1px solid;
  border-color: #000; }
  .scenario-table th {
    text-align: center;
    padding: 10px; }
  .scenario-table tr {
    margin-top: 25px;
    border: 1px solid;
    border-color: #000; }
  .scenario-table td {
    margin-bottom: 25px;
    border: 1px solid;
    border-color: #000;
    padding-left: 10px;
    padding-right: 10px; }

.tags-inline {
  display: flex;
  align-items: baseline;
  gap: 0.5em; }
  .tags-inline h5 {
    margin: 0; }
  .tags-inline ul.taglist {
    margin: 0;
    padding-left: 0; }
  .tags-inline.tags-pre-body {
    margin-bottom: 1em; }

ul.taglist {
  list-style: none; }
  ul.taglist li.tag {
    display: inline;
    font-style: italic; }

ol.letterlist {
  list-style-type: upper-alpha; }
  ol.letterlist li:before {
    color: red; }

/* Blog index listing: title as heading, not 1999 link */
article.listing {
  margin-bottom: 1.75em;
  font-size: 0.9875em; }
  article.listing:first-child {
    margin-top: 1.125em; }
  article.listing h3 {
    font-size: 1.25em;
    font-weight: bold; }
  article.listing h3 a {
    color: inherit;
    text-decoration: none;
    font-weight: bold; }
    article.listing h3 a:hover, article.listing h3 a:focus {
      color: #003d82;
      text-decoration: none; }
  article.listing .listing-excerpt {
    /* Run first paragraph on same line as date */
    /* "read on" at end of last line of excerpt */ }
    article.listing .listing-excerpt .listing-date {
      font-size: 1em;
      font-weight: bold;
      margin-right: 0.35em; }
    article.listing .listing-excerpt > p {
      display: inline; }
    article.listing .listing-excerpt .more {
      display: inline; }
      article.listing .listing-excerpt .more::before {
        content: " "; }

.turn-sequence {
  font-style: italic;
  font-size: 90%;
  color: #ecc9c9; }

aside {
  margin-top: 1em;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-size: 120%;
  padding: 20px;
  background: #dfd8df;
  color: #6a6767;
  font-style: italic; }

/* Same margin and padding as archive (aside) box, no other styling */
.sidebar .sidebar-box {
  margin-top: 1em;
  padding: 20px; }

/* details with a triangle toggle */
details summary {
  cursor: pointer; }

details summary::before {
  content: "▼";
  display: inline-block;
  margin-left: 0.5em; }

details[open] summary::before {
  content: "▲"; }

.blog > .hentry {
  margin-top: 1.125em; }

.blog h1,
.blog .h1 {
  font-size: 36px; }

.blog h2,
.blog .h2 {
  font-size: 24px; }

.blog h3,
.blog .h3 {
  font-size: 18px; }

.blog h5.gametitle {
  font-size: 17px;
  font-weight: bold;
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  color: #777777;
  border-bottom: 1px solid #ccc;
  padding-bottom: 0.25em; }

.blog h4,
.blog .h4 {
  font-size: 16px;
  font-style: italic;
  text-decoration: underline; }

.blog h5,
.blog .h5 {
  font-size: 12px; }

.blog h6,
.blog .h6 {
  font-size: 12px;
  font-style: italic; }

.indented {
  margin-left: 2em; }
